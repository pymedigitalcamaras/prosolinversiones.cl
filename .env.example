# F3-A no requiere servicios externos.
# Acceso demo local deshabilitado por defecto. No usar en Vercel ni con Supabase configurado.
F3_LOCAL_DEMO=false
# Secret local de al menos 32 caracteres; el valor real nunca se versiona.
F3_DEMO_SESSION_SECRET=
# En localhost HTTP debe permanecer false. El adaptador productivo se definirá después.
F3_DEMO_SECURE_COOKIE=false
